<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BateAi.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/verde</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/azul</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorPrimary">@color/azul</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.BateAi" parent="Theme.BateAi.Base" />
    <style name="Titulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Descricao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>
    <style name="Rotulo" parent="Descricao">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/campo</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>
    <style name="Botao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/botao</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BotaoSecundario" parent="Botao">
        <item name="android:background">@drawable/botao_secundario</item>
        <item name="android:textColor">@color/azul</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>
</resources>
